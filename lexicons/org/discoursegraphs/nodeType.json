{
  "lexicon": 1,
  "id": "org.discoursegraphs.nodeType",
  "description": "A node type in a grammar.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "label",
          "createdAt"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 256
          },
          "abbreviation": {
            "type": "string",
            "maxLength": 16
          },
          "base": {
            "type": "string",
            "maxLength": 64
          },
          "color": {
            "type": "string",
            "maxLength": 32
          },
          "lexicon": {
            "type": "string",
            "format": "nsid"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}