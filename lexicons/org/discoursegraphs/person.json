{
  "lexicon": 1,
  "id": "org.discoursegraphs.person",
  "description": "Display details for a person, whose repo DID is their identity.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "name",
          "createdAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "orcid": {
            "type": "string",
            "format": "uri"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}