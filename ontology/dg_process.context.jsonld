{
  "@context": {
    "@version": 1.1,
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "dg": "https://discoursegraphs.com/schema/dg_core#",
    "dgp": "https://discoursegraphs.com/schema/dg_process#",
    "id": "@id",
    "type": "@type",
    "Question": "dg:Question",
    "Claim": "dg:Claim",
    "Evidence": "dg:Evidence",
    "Source": "dg:Source",
    "Protocol": "dgp:Protocol",
    "Study": "dgp:Study",
    "Run": "dgp:Run",
    "Code": "dgp:Code",
    "Output": "dgp:Output",
    "Pin": "dgp:Pin",
    "title": "dct:title",
    "attributedTo": {
      "@id": "prov:wasAttributedTo",
      "@type": "@id",
      "@container": "@set"
    },
    "created": {
      "@id": "dct:created",
      "@type": "xsd:dateTime"
    },
    "question": {
      "@id": "dgp:question",
      "@type": "@id"
    },
    "protocols": {
      "@id": "dgp:protocols",
      "@type": "@id",
      "@container": "@set"
    },
    "implementedBy": {
      "@id": "dgp:implementedBy",
      "@type": "@id",
      "@container": "@set"
    },
    "conditions": {
      "@id": "dgp:conditions",
      "@container": "@set"
    },
    "version": "schema:version",
    "sameAs": {
      "@id": "schema:sameAs",
      "@type": "@id",
      "@container": "@set"
    },
    "partOf": {
      "@id": "dgp:partOf",
      "@type": "@id"
    },
    "follows": {
      "@id": "dgp:follows"
    },
    "instrument": {
      "@id": "dgp:instrument",
      "@container": "@set"
    },
    "used": {
      "@id": "dgp:used",
      "@container": "@set"
    },
    "target": {
      "@id": "dgp:target",
      "@type": "@id"
    },
    "cid": "dgp:cid",
    "status": "dgp:status",
    "startedAt": {
      "@id": "prov:startedAtTime",
      "@type": "xsd:dateTime"
    },
    "endedAt": {
      "@id": "prov:endedAtTime",
      "@type": "xsd:dateTime"
    },
    "agents": {
      "@id": "prov:wasAssociatedWith",
      "@type": "@id",
      "@container": "@set"
    },
    "fingerprint": "dgp:fingerprint",
    "parameterValues": {
      "@id": "dgp:parameterValues",
      "@type": "@json"
    },
    "environment": {
      "@id": "dgp:environment",
      "@type": "@json"
    },
    "repo": {
      "@id": "schema:codeRepository",
      "@type": "@id"
    },
    "commit": "dgp:commit",
    "path": "dgp:path",
    "sourceCid": "dgp:sourceCid",
    "language": "schema:programmingLanguage",
    "swhid": "dgp:swhid",
    "generatedBy": {
      "@id": "dgp:generatedBy",
      "@type": "@id"
    },
    "derivedFrom": {
      "@id": "dgp:derivedFrom",
      "@container": "@set"
    },
    "uri": {
      "@id": "schema:contentUrl",
      "@type": "@id"
    },
    "mediaType": "schema:encodingFormat",
    "byteSize": {
      "@id": "dgp:byteSize",
      "@type": "xsd:integer"
    },
    "outputKind": "dgp:outputKind",
    "locator": {
      "@id": "dgp:locator",
      "@type": "@json"
    },
    "caption": "schema:caption",
    "observationBase": {
      "@id": "dgp:observationBase",
      "@container": "@set"
    },
    "isGroundedIn": {
      "@id": "dgp:isGroundedIn",
      "@type": "@id"
    },
    "sourceDocument": {
      "@id": "dgp:sourceDocument",
      "@type": "@id"
    },
    "describesActivity": {
      "@id": "dgp:describesActivity",
      "@type": "@id",
      "@container": "@set"
    },
    "anchor": {
      "@id": "dgp:anchor",
      "@type": "@json"
    },
    "doi": {
      "@id": "schema:identifier",
      "@type": "@id"
    },
    "provenance": {
      "@id": "dgp:provenance",
      "@type": "@json"
    },
    "supports": {
      "@id": "dgp:supports",
      "@type": "@id",
      "@container": "@set"
    },
    "opposes": {
      "@id": "dgp:opposes",
      "@type": "@id",
      "@container": "@set"
    },
    "addresses": {
      "@id": "dgp:addresses",
      "@type": "@id",
      "@container": "@set"
    },
    "informs": {
      "@id": "dgp:informs",
      "@type": "@id",
      "@container": "@set"
    },
    "versionCid": "dgp:versionCid",
    "steps": {
      "@id": "dgp:steps",
      "@container": "@list"
    },
    "parameters": {
      "@id": "dgp:parameters",
      "@type": "@json"
    },
    "materials": {
      "@id": "dgp:materials",
      "@container": "@set"
    },
    "hypothesis": "dgp:hypothesis",
    "design": "dgp:design",
    "variables": {
      "@id": "dgp:variables",
      "@type": "@json"
    },
    "sampleSize": {
      "@id": "dgp:sampleSize",
      "@type": "xsd:integer"
    },
    "preregistration": {
      "@id": "dgp:preregistration",
      "@type": "@id"
    },
    "condition": "dgp:condition",
    "deviations": {
      "@id": "dgp:deviations",
      "@container": "@set"
    },
    "seeAlso": {
      "@id": "http://www.w3.org/2000/01/rdf-schema#seeAlso",
      "@type": "@id",
      "@container": "@set"
    },
    "license": "schema:license",
    "openalex": {
      "@id": "schema:sameAs",
      "@type": "@id"
    }
  }
}
