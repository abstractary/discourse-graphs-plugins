{
  "name": "discourse-graphs-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo: Discourse Graphs plugins for Roam and Obsidian, sharing one core, canvas and panels",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:server": "npm test --workspace @dg/server",
    "check-types": "tsc --noEmit",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "build": "DG_RELEASE=1 node scripts/build.mjs",
    "build:test": "node scripts/build.mjs",
    "server": "node scripts/serve.mjs",
    "coverage": "python3 -I scripts/host_coverage.py"
  },
  "devDependencies": {
    "@atproto/crypto": "0.5.7",
    "@atproto/lexicon": "0.7.17",
    "@codemirror/language": "^6.13.1",
    "@did-plc/lib": "0.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "elkjs": "^0.11.1",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "5.5.4"
  },
  "workspaces": [
    "packages/*",
    "plugins/*",
    "server"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/abstractary/discourse-graphs-plugins.git"
  },
  "engines": {
    "node": ">=26"
  }
}
