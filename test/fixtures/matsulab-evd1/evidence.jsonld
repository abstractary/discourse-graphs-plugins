    {
      "@id": "#protocol",
      "@type": "Protocol",
      "title": "Discourse graph conversion rate analysis",
      "content": "Automated pipeline parsing JSON-LD and Roam JSON exports to identify issue nodes (320 formal ISS + 125 experiment pages), detect claiming via a two-tier strategy (explicitly claimed via Claimed By:: field, n=69; inferred via experimental log presence, n=56; plus 5 ISS pages with activity), and link result nodes using a 3-tier matching strategy (relation instances, backreference matching, full description matching).",
      "description": "methods_excerpt.md",
      "has_container": "./"
    },
    {
      "@id": "https://experiment.com/u/Hd2AYg",
      "@type": "SourceDocument",
      "title": "Narrative post describing the MATSUlab discourse graph analysis",
      "format": "text/html",
      "describesActivity": "#study"
    },
    {
      "@id": "#matsulab-graph",
      "@type": [
        "Container",
        "prov:Entity"
      ],
      "title": "MATSUlab discourse graph",
      "content": "Akamatsu Lab Roam Research discourse graph, February 2026 snapshot. Contains 445 identifiable issues (320 formal ISS nodes + 125 experiment pages), 130 claimed experiments, and 323 result nodes.",
      "temporal": "2026-02-14"
    },
    {
      "@id": "#source-1",
      "@type": [
        "Item",
        "prov:Entity"
      ],
      "title": "akamatsulab_discourse-graph-json-LD202602112140.json (raw input, not included in this repository)",
